# Copy to .kspm.yaml at your repo root to set repo-wide defaults.
# CLI flags (--ignore-rule, --exclude-namespace, --fail-on) always win over
# these values.

# Rule IDs to never report (see README for the full rule table).
ignore_rules: []
# ignore_rules:
#   - KSPM010   # allow :latest tags in this repo

# Namespaces to skip during `kspm live` scans.
exclude_namespaces:
  - kube-system
  - kube-public
  - kube-node-lease

# Minimum severity that causes a non-zero exit code (CI gating).
# One of: CRITICAL, HIGH, MEDIUM, LOW, INFO, NONE.
fail_on: HIGH
